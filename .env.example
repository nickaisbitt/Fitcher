# Server
PORT=3000
NODE_ENV=development

# Database (set to a real Postgres URL or leave blank for mock mode)
# For docker-compose local dev:
DATABASE_URL=postgresql://fitcher:fitcher_dev@localhost:5432/fitcher

# JWT (CHANGE THIS IN PRODUCTION)
JWT_SECRET=change-me-to-a-random-256-bit-key
JWT_EXPIRES_IN=24h

# Redis (leave blank for mock mode)
# For docker-compose local dev:
REDIS_URL=redis://localhost:6379

# Exchange API Keys (optional - for live trading)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Security
ENCRYPTION_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# AI (optional)
OPENROUTER_API_KEY=
DEFAULT_AI_MODEL=anthropic/claude-3.5-sonnet
